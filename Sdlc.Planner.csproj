<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NuGetAudit>false</NuGetAudit>
    <PackageId>Sdlc.Planner</PackageId>
    <Version>1.0.0</Version>
    <Authors>Daniel Vella</Authors>
    <Copyright>Copyright (c) Daniel Vella</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Sdlc.Planner AI harness: Copilot agents, instructions and docs templates (requirements, architecture, designs, user stories, QA, ticket sync for Jira or Kaneo) synced into the consuming repo on build.</Description>
    <PackageTags>copilot;agents;skills;sdlc;planning</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Content-only package: no assembly, no dependencies. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="content\**" Pack="true" PackagePath="sdlc-planner\" />
    <None Include="skills\**" Pack="true" PackagePath="skills\" />
  </ItemGroup>

</Project>

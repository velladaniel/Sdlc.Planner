{
  "inputs": [
    {
      "id": "jira-username",
      "type": "promptString",
      "description": "Your Atlassian/Jira account email"
    },
    {
      "id": "jira-api-token",
      "type": "promptString",
      "description": "Jira Cloud API token (create at https://id.atlassian.com/manage-profile/security/api-tokens)",
      "password": true
    }
  ],
  "servers": {
    "mcp-atlassian": {
      "type": "stdio",
      "command": "podman",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v", "${workspaceFolder}/docs/designs:/app/data/designs:ro",
        "-e", "JIRA_URL",
        "-e", "JIRA_USERNAME",
        "-e", "JIRA_API_TOKEN",
        "-e", "JIRA_SSL_VERIFY",
        "ghcr.io/sooperset/mcp-atlassian:latest"
      ],
      "env": {
        "JIRA_URL": "https://<your-tenant>.atlassian.net",
        "JIRA_USERNAME": "${input:jira-username}",
        "JIRA_API_TOKEN": "${input:jira-api-token}",
        "JIRA_SSL_VERIFY": "true"
      }
    }
  }
}
